DB_URL=jdbc:postgresql://<NEON_HOST>/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=<NEON_PASSWORD>

# Optional explicit development Admin command; never production credentials.
DEV_ADMIN_EMAIL=<DEVELOPMENT_ADMIN_EMAIL>
DEV_ADMIN_PASSWORD=<DEVELOPMENT_ADMIN_PASSWORD>
DEV_ADMIN_NAME=<DEVELOPMENT_ADMIN_NAME>
DEV_ADMIN_PHONE=<VALID_VIETNAMESE_PHONE>

# Gmail SMTP: dedicated development/demo sender, Google App Password only.
# Keep delivery disabled until explicitly configured; missing credentials never mean success.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<DEDICATED_GMAIL_SENDER>
SMTP_APP_PASSWORD=<GOOGLE_APP_PASSWORD>
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLED=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
MAIL_FROM_ADDRESS=<SENDER_OR_AUTHORIZED_ALIAS>
MAIL_FROM_NAME=Smart Cinema
STAFF_ACTIVATION_BASE_URL=https://your-frontend-domain.example/staff/activate
STAFF_INVITATION_DELIVERY_ENABLED=false
# 32 random bytes per AES key, base64; external secret manager/env only, never database.
STAFF_INVITATION_ACTIVE_KEY_ID=key-1
STAFF_INVITATION_ENCRYPTION_KEYS=key-1:<BASE64_32_BYTE_SECRET>
STAFF_INVITATION_MAX_ATTEMPTS=5
STAFF_INVITATION_RETRY_INITIAL=PT30S
STAFF_INVITATION_RETRY_MAX=PT30M
STAFF_INVITATION_LEASE=PT5M
STAFF_INVITATION_ALLOW_LOCAL_SMTP=false
