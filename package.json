{
  "name": "smart-cinema-development",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "admin:dev": "cd backend && mvn spring-boot:run -Dspring-boot.run.main-class=com.smartcinema.development.DevelopmentAdminApplication -Dspring-boot.run.arguments=--development.admin.confirm=development-only",
    "seed:demo": "cd backend && mvn spring-boot:run -Dspring-boot.run.main-class=com.smartcinema.demo.DemoSeedApplication -Dspring-boot.run.arguments=--demo.seed.confirm=development-only",
    "dev": "node scripts/dev.mjs",
    "db:status": "node scripts/dev.mjs status",
    "db:migrate": "node scripts/dev.mjs migrate",
    "test:dev": "node --test scripts/dev.test.mjs"
  },
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
